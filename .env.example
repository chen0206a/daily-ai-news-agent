# Copy to .env. Environment variables override this file. Never commit credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SCHEDULER_ENABLED=true
MAX_MODEL_TURNS=18
MAX_TOOL_CALLS=45
RUN_TIMEOUT_SECONDS=300
# Optional SMTP. Email subscriptions default OFF. Set STARTTLS=true for port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
